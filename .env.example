# Salin ke .env lalu sesuaikan. Lihat README.md untuk penjelasan.

# URL backend Laravel (dipakai saat NUXT_PUBLIC_USE_MOCK=false)
NUXT_PUBLIC_API_BASE=http://localhost:8000

# true = pakai mock API bawaan Nuxt (default), false = panggil Laravel
NUXT_PUBLIC_USE_MOCK=true

# URL publik aplikasi (untuk SEO/canonical)
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Realtime (Laravel Reverb / Soketi) — opsional
NUXT_PUBLIC_REALTIME_ENABLED=false
NUXT_PUBLIC_REALTIME_KEY=
NUXT_PUBLIC_REALTIME_HOST=localhost
NUXT_PUBLIC_REALTIME_PORT=8080
NUXT_PUBLIC_REALTIME_WSS_PORT=8081
NUXT_PUBLIC_REALTIME_TLS=false
NUXT_PUBLIC_REALTIME_CLUSTER=mt1
